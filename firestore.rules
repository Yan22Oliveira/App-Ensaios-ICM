rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // -------- Helpers --------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid));
    }

    function isActive() {
      return isSignedIn()
        && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && userDoc().data.active == true;
    }

    function role() {
      return isSignedIn() ? userDoc().data.role : "readonly";
    }

    function userRegionId() { return userDoc().data.regionId; }
    function userAreaId()   { return userDoc().data.areaId; }
    function userPoloId()   { return userDoc().data.poloId; }

    function regionMaanaimId(regionId) {
      return exists(/databases/$(db)/documents/regions/$(regionId))
        ? get(/databases/$(db)/documents/regions/$(regionId)).data.maanaimId
        : '';
    }

    // get/create/update/delete: pode usar get()/exists() (documento único).
    function canSeeRehearsal(data) {
      return isActive() && (
        role() == 'admin' ||
        // Maanaim: ensaio do próprio maanaim, ou região/área/polo cujo doc em /regions
        // tem maanaimId == user.regionId (id do maanaim no perfil).
        (role() == 'maanaim' && (
          (data.level == 'maanaim' && data.regionId == userRegionId()) ||
          (data.level in ['region','area','polo'] && regionMaanaimId(data.regionId) == userRegionId())
        )) ||

        (role() == 'region'  && data.regionId == userRegionId() && (data.level in ['region','area','polo'])) ||
        (role() == 'area'    && data.areaId == userAreaId() && (data.level in ['area','polo'])) ||
        (role() == 'polo'    && data.level == 'polo' && data.poloId == userPoloId()) ||

        (role() == 'readonly' && (
          (data.level == 'polo'   && data.poloId   == userPoloId()) ||
          (data.level == 'area'   && data.areaId   == userAreaId()) ||
          (data.level == 'region' && data.regionId == userRegionId())
        ))
      );
    }

    // list: Firestore NÃO avalia get()/exists() em queries. As constraints da query
    // precisam provar o acesso. Para maanaim, a listagem de região/área/polo usa
    // whereIn(regionId) — o cliente ainda filtra pelo conjunto de regiões do maanaim.
    function canListRehearsal(data) {
      return isActive() && (
        role() == 'admin' ||
        (role() == 'maanaim' && (
          (data.level == 'maanaim' && data.regionId == userRegionId()) ||
          (data.level in ['region','area','polo'])
        )) ||
        (role() == 'region'  && data.regionId == userRegionId() && (data.level in ['region','area','polo'])) ||
        (role() == 'area'    && data.areaId == userAreaId() && (data.level in ['area','polo'])) ||
        (role() == 'polo'    && data.level == 'polo' && data.poloId == userPoloId()) ||
        (role() == 'readonly' && (
          (data.level == 'polo'   && data.poloId   == userPoloId()) ||
          (data.level == 'area'   && data.areaId   == userAreaId()) ||
          (data.level == 'region' && data.regionId == userRegionId())
        ))
      );
    }

    // -------- Collections --------

    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || (isActive() && role() == 'admin'));
      allow list: if isActive() && role() == 'admin';
      allow create: if isActive() && role() == 'admin';
      allow update: if (isActive() && role() == 'admin')
        || (
          isSignedIn()
          && request.auth.uid == uid
          && isActive()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'phone', 'updatedAt', 'photoUrl'])
        );
      allow delete: if false;
    }

    match /rehearsals/{id} {
      allow get: if canSeeRehearsal(resource.data);
      allow list: if canListRehearsal(resource.data);

      allow create, update: if canSeeRehearsal(request.resource.data);
      allow delete: if canSeeRehearsal(resource.data);
    }

    match /people/{id} {
      // leitura para usuários ativos (se quiser, aplique escopo por region/area/polo do doc)
      allow read: if isActive();
      // ajuste se quiser restringir por papel
      allow create, update, delete: if isActive();
    }

    match /eventReports/{id} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isActive() && (role() in ['admin','region','area','polo','maanaim']);
    }

    match /attendance/{id} {
      // leitura para usuários ativos; você pode cruzar escopo pelo rehearsalId via rules mais avançadas
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isActive() && (role() in ['admin','region','area','polo']);
    }

    match /regions/{id} { allow read: if isActive(); }
    match /areas/{id}   { allow read: if isActive(); }
    match /polos/{id}   { allow read: if isActive(); }
    // maanains: leitura para qualquer usuário autenticado (evita permission-denied antes do perfil estar ativo)
    match /maanains/{id} { allow read: if isSignedIn(); }
    match /maanains/{maanaimId}/regions/{id} { allow read: if isSignedIn(); }

    match /roles/{id} { allow read: if isSignedIn(); }

    match /accessRequests/{id} {
      // aberto para o wizard de solicitação
      allow create: if true;
      // leitura/alteração somente por admins
      allow read, update, delete: if isActive() && role() == 'admin';
    }
  }
}
